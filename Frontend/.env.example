# ==========================================================
# Configuración de entorno para Adi Estilos - FRONTEND
# Copia este archivo como .env (desarrollo) o define las
# variables en el panel de Vercel (producción).
# ==========================================================

# --- DESARROLLO ---
VITE_API_URL=http://localhost:3000/api
VITE_FILES_URL=http://localhost:3000

# --- PRODUCCIÓN (Vercel) ---
# Reemplaza por la URL real de tu backend (Railway).
# VITE_API_URL=https://TU-BACKEND.up.railway.app/api
# VITE_FILES_URL=https://TU-BACKEND.up.railway.app

# Nombre mostrado de la app (opcional)
VITE_APP_NAME=Adi Estilos