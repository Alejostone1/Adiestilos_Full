# ==========================================================
# Configuración de entorno para Adi Estilos - BACKEND
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a Git: solo este .env.example.
# ==========================================================

# Entorno: development | production
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL)
# LOCAL:
DATABASE_URL="postgresql://usuario:password@localhost:5432/adiweb"
# RAILWAY (producción): usa la Connection String que Railway te da en
# Railway -> Proyecto -> PostgreSQL -> Connect -> Connection String
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/adiweb?schema=public"

# JWT (OBLIGATORIO: mínimo 32 caracteres)
JWT_SECRET=genera_un_secreto_largo_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h

# Bcrypt
BCRYPT_ROUNDS=10

# CORS: orígenes permitidos separados por coma.
# Local: http://localhost:5173
# Producción: el dominio de Vercel, ej. https://adi-estilos.vercel.app
CORS_ORIGIN=http://localhost:5173

# Uploads (solo desarrollo local)
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# API
API_VERSION=v1
API_PREFIX=/api

# Cloudinary (almacenamiento de imágenes en PRODUCCIÓN)
# Cloudinary Dashboard -> Settings -> Access Keys
# Si se dejan vacíos, las subidas se guardan en /uploads (solo local).
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=adi-estilos